{
  "manifest_version": 3,
  "name": "RAMOS Maps Connector",
  "version": "1.0.0",
  "description": "Standalone Chrome extension for Google Maps business discovery, detail enrichment, and CSV export.",
  "permissions": ["storage", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://www.google.com/maps*",
    "https://*.google.com/maps*",
    "https://maps.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RAMOS Maps Connector",
    "default_icon": { "128": "icon.png" }
  },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://*.google.com/maps*",
        "https://maps.google.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/schema.js",
        "content/maps/dom-utils.js",
        "content/maps/selectors.js",
        "content/maps/validators.js",
        "content/maps/address-parser.js",
        "content/maps/result-card-extractor.js",
        "content/maps/detail-extractor.js",
        "content/maps/maps-adapter.js",
        "discovery.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "popup.css", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
