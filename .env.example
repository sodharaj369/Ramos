# Copy to .env for local development. Variable names only — never commit real values.
#
# Option A: Local Supabase Docker Stack (npx supabase start)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PROJECT_ID=local
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PROJECT_ID=local
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
#
# Option B: Lovable Cloud Supabase (Remote)
# SUPABASE_URL=https://<project-id>.supabase.co
# SUPABASE_PROJECT_ID=<project-id>
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_URL=https://<project-id>.supabase.co
# VITE_SUPABASE_PROJECT_ID=<project-id>
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Lead discovery: self-hosted google-maps-scraper (server-side only) ---
GMAPS_SCRAPER_URL=
GMAPS_SCRAPER_API_KEY=
GMAPS_SCRAPER_MODE=
GMAPS_SCRAPER_LANG=
GMAPS_SCRAPER_ZOOM=
GMAPS_SCRAPER_MAX_WAIT_MS=

# --- Optional external email verifier (server-side only) ---
EMAIL_VERIFIER_ENDPOINT=
EMAIL_VERIFIER_API_KEY=

# Self-hosted free SMTP verification service (email-verifier-service/)
EMAIL_VERIFIER_URL=
EMAIL_VERIFIER_API_KEY=
