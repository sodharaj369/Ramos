# Copy to .env for local development. Variable names only — never commit real values.
# On Lovable Cloud, the SUPABASE_*/VITE_SUPABASE_* values are generated automatically
# and the provider secrets below are stored server-side in the secret store.

# --- Backend (generated by Lovable Cloud; publishable values only) ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Lead discovery: self-hosted google-maps-scraper (server-side only) ---
GMAPS_SCRAPER_URL=
GMAPS_SCRAPER_API_KEY=
GMAPS_SCRAPER_MODE=
GMAPS_SCRAPER_LANG=
GMAPS_SCRAPER_ZOOM=
GMAPS_SCRAPER_MAX_WAIT_MS=

# --- Optional external email verifier (server-side only) ---
EMAIL_VERIFIER_ENDPOINT=
EMAIL_VERIFIER_API_KEY=

# Self-hosted free SMTP verification service (email-verifier-service/)
EMAIL_VERIFIER_URL=
EMAIL_VERIFIER_API_KEY=
